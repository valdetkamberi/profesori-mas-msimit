# Optional: used only for explanations and image-to-math extraction.
# Math solving itself runs locally with SymPy.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_API_KEY_FALLBACK="your_fallback_gemini_api_key_here"
GEMINI_API_KEY_FALLBACK_2="your_second_fallback_gemini_api_key_here"

# Optional: used as a fallback when Python/SymPy cannot solve a problem.
WOLFRAM_APP_ID="your_wolfram_app_id_here"

# Optional: path to a Python executable with SymPy installed.
PYTHON_BIN=".venv/Scripts/python.exe"
